                                        android:id="@+id/ocnic"
                                        />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="130dp"
                                        android:layout_height="wrap_content"
                                        android:text="Mobile Number"
                                        />
                                    <TextView
                                        android:id="@+id/ophone"
                                        android:layout_width="180dp"                                android:layout_height="wrap_content"
                                        android:text="+92300 8811761"
                                        />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="130dp"
                                        android:layout_height="wrap_content"
                                        android:text="Shop Name"
                                        />
                                    <TextView
                                        android:id="@+id/sname"
                                        android:layout_width="180dp"                                android:layout_height="wrap_content"
                                        android:text=""
                                        />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="130dp"
                                        android:layout_height="wrap_content"
                                        android:text="Total Charges Left"
                                        />
                                    <TextView
                                        android:id="@+id/scharges"
                                        android:layout_width="180dp"                                android:layout_height="wrap_content"
                                        android:text=""
                                        />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="130dp"
                                        android:layout_height="wrap_content"
                                        android:text="Shop Registration#"
                                        />
                                    <TextView
                                        android:id="@+id/sregnumber"
                                        android:layout_width="180dp"                                android:layout_height="wrap_content"
                                        android:text=""
                                        />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="130dp"
                                        android:layout_height="wrap_content"
                                        android:text="Owner's Email ID"
                                        />
                                    <TextView
                                        android:layout_width="wrap_content"                                android:layout_height="wrap_content"
                                        android:id="@+id/oemail"
                                        />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="130dp"
                                        android:layout_height="wrap_content"
                                        android:text="Registration ID"
                                        />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:id="@+id/tid"
                                        />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="16dp"
                                        android:text="Complain"
                                        android:layout_gravity="center"
                                        android:layout_marginTop="2dp"
                                        android:textColor="@color/end_red"
                                        android:textStyle="bold"/>
                                    <androidx.cardview.widget.CardView
                                        android:layout_width="2.2in"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        app:cardElevation="10dp"
                                        app:cardBackgroundColor="#DBE2EB"
                                        >

                                        <TextView
                                            android:layout_gravity="center"
                                            android:layout_width="2.1in"
                                            android:textSize="15dp"
                                            android:textColor="@color/black"
                                            android:textStyle="italic"
                                            android:layout_height="wrap_content"
                                            android:id="@+id/complain"
                                            android:text="this is complain. this is complain. this is complain. this is complain. this is complain. this is complain. this is complain. this is complain. this is complain. this is complain"
                                            />

                                    </androidx.cardview.widget.CardView>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="6dp"
                                        />
                                </LinearLayout>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="5dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="300dp"
                                android:layout_height="wrap_content"
                                android:textSize="16dp"
                                android:text="Take Action"
                                android:textColor="@color/black"
                                android:textStyle="bold"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="5dp"/>
                            <RadioGroup
                                android:id="@+id/action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                >
                                <RadioButton
                                    android:id="@+id/deleteaccount"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="20dp"
                                    android:checked="true"
                                    android:text="Delete towing account permanently"
                                    android:textSize="14sp" />
                                <RadioButton
                                    android:id="@+id/deductcharges"
                                    android:layout_marginTop="8dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="20dp"
                                    android:text="Deduct charges"
                                    android:textSize="14sp" />
                               <!-- <RadioButton
                                    android:id="@+id/contactcustomer"
                                    android:layout_marginTop="-5dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="20dp"
                                    android:text="Contact (Customer name)"
                                    android:textSize="14sp" />
                                <RadioButton
                                    android:id="@+id/contacttowingshop"
                                    android:layout_marginTop="-5dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="20dp"
                                    android:text="Contact (Shop name)"
                                    android:textSize="14sp" />-->
                                <RadioButton
                                    android:id="@+id/ignorecomplain"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="20dp"
                                    android:text="Ignore Complain"
                                    android:layout_marginTop="8dp"
                                    android:textSize="14sp" />

                            </RadioGroup>
                    </LinearLayout>

                    <Button
                        android:id="@+id/proceed"
                        android:layout_width="220dp"
                        android:layout_height="53dp"
                        android:layout_gravity="center"
                        android:backgroundTint="#2D5593"
                        android:text="Proceed"
                        android:textSize="18dp"
                        app:cornerRadius="20dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="1in"></TextView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardElevation="10dp"

                        android:layout_gravity="center">
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </ScrollView>
