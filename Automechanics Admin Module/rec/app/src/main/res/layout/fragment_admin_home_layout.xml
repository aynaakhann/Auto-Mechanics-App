<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".admin_home_layout"
    android:orientation="horizontal">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <WebView
                android:id="@+id/chartWebView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                />

            <GridLayout
                android:id="@+id/gridLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_gravity="center"
                android:backgroundTint="#EFECEC"
                android:columnCount="2"
                android:rowCount="2"
                >

                <androidx.cardview.widget.CardView
                    android:layout_width="152dp"
                    android:layout_height="185dp"
                    android:layout_row="0"
                    android:layout_column="0"
                    android:layout_margin="5dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Pending Mechanic Requests"
                            android:textSize="15dp"></TextView>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@android:color/darker_gray" />

                        <TextView
                            android:id="@+id/pending_mech_req"
                            android:textColor="@color/end_red"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="80dp"
                            android:layout_width="wrap_content"
                            android:layout_height="95dp"
                            />

                        <TextView
                            android:id="@+id/date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Till 16th May,2023"
                            android:textSize="13dp"></TextView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="152dp"
                    android:layout_height="185dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_margin="5dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Pending Towing Shop Requests"
                            android:textSize="15dp"></TextView>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@android:color/darker_gray" />

                        <TextView
                            android:id="@+id/pending_tow_req"
                            android:textColor="@color/end_red"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="80dp"
                            android:layout_width="wrap_content"
                            android:layout_height="95dp"
                            />

                        <TextView
                            android:id="@+id/datee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Till 16th May,2023"
                            android:textSize="13dp"></TextView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/white" />

            <GridLayout
                android:id="@+id/gridLayoutt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_gravity="center"
                android:backgroundTint="#EFECEC"
                android:columnCount="2"
                android:rowCount="2"
                >

                <androidx.cardview.widget.CardView
                android:layout_width="152dp"
                android:layout_height="185dp"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_margin="5dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Mechanic Complains\n "
                        android:textSize="15dp"></TextView>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/mechanic_complains"
                        android:textColor="@color/end_red"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:textSize="80dp"
                        android:layout_width="wrap_content"
                        android:layout_height="95dp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:id="@+id/dateee"
                        android:text="Till 16th May,2023"
                        android:textSize="13dp"></TextView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="152dp"
                    android:layout_height="185dp"
                    android:layout_row="0"
                    android:layout_column="1"
                    android:layout_margin="5dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Towing Shop Complains"
                            android:textSize="15dp"></TextView>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@android:color/darker_gray" />

                        <TextView
                            android:id="@+id/towing_complains"
                            android:textColor="@color/end_red"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="80dp"
                            android:layout_width="wrap_content"
                            android:layout_height="95dp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Till 16th May,2023"
                            android:textSize="13dp"
                            android:id="@+id/datte"
                            ></TextView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@android:color/white" />
            <GridLayout
                android:id="@+id/gridLayott"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_gravity="center"
                android:backgroundTint="#EFECEC"
                android:columnCount="2"
                android:rowCount="2"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="152dp"
                    android:layout_height="185dp"
                    android:layout_row="1"
                    android:layout_column="0"
                    android:layout_margin="5dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Mechanic Account Activation Requests"
                            android:textSize="15dp"></TextView>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@android:color/darker_gray" />

                        <TextView
                            android:id="@+id/mech_acti"
                            android:textColor="@color/end_red"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="80dp"
                            android:layout_width="wrap_content"
                            android:layout_height="95dp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Till 16th May,2023"
                            android:textSize="13dp"
                            android:id="@+id/dattte"
                            ></TextView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="152dp"
                    android:layout_height="185dp"
                    android:layout_row="1"
                    android:layout_column="1"
                    android:layout_margin="5dp"
                    >
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="170dp"
                        android:layout_gravity="center_vertical|center_horizontal"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Towing Account Activation Requests"
                            android:textSize="15dp"></TextView>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@android:color/darker_gray" />

                        <TextView
                            android:id="@+id/towing_acti"
                            android:textColor="@color/end_red"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:textSize="80dp"
                            android:layout_width="wrap_content"
                            android:layout_height="95dp"
                            />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Till 16th May,2023"
                            android:textSize="13dp"
                            android:id="@+id/daatte"
                            ></TextView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>