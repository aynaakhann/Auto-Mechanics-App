<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_height="match_parent" android:layout_width="match_parent">

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".MechEndJob">

        <fragment
            android:id="@+id/Mechlastmap"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="620dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/alertcallM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="30dp"
            android:layout_marginTop="330dp"
            android:layout_marginEnd="23dp"
            android:src="@drawable/ic_alert_call"
            app:backgroundTint="@color/white"
            app:fabCustomSize="40dp"
            app:tint="#FF0000" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/shareLocationM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/alertcallM"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="23dp"
            android:src="@drawable/ic_send_location"
            app:backgroundTint="@color/white"
            app:fabCustomSize="40dp"
            app:tint="@color/teal_700" />

        <Button
            android:id="@+id/endJobM"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="636dp"
            android:layout_marginStart="115dp"
            android:layout_marginEnd="110dp"
            android:text="End Job"
            android:textSize="20dp" />

    </RelativeLayout>
</ScrollView>