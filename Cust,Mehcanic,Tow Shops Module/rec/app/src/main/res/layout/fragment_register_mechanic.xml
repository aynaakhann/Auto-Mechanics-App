<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="305dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".register_mechanic">
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="305dp"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:layout_marginLeft="12dp"
            android:orientation="vertical"
            >
            <LinearLayout
                android:layout_width="305dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@color/white"
                android:gravity="center"
                android:layout_marginTop="25dp"
                android:orientation="vertical"
                >


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/picUpload"
                    android:layout_width="173dp"
                    android:layout_height="99dp"
                    android:layout_weight="1"
                    android:layout_marginTop="20dp"
                    app:civ_border_color="@color/end_red"
                    app:civ_border_width="2dp"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/edit_text"
                    android:id="@+id/username"
                    android:drawableLeft="@drawable/ic_person"
                    android:drawablePadding="20dp"
                    android:hint="@string/full_name"
                    android:maxLength="15"
                    android:inputType="text"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginTop="15dp"
                    android:textColorHighlight="@color/cardview_dark_background" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/edit_text"
                    android:id="@+id/cnic"
                    android:drawableLeft="@drawable/cnic"
                    android:drawablePadding="20dp"
                    android:hint="Cnic: 00000-0000000-0"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:maxLength="15"
                    android:inputType="text"
                    android:layout_marginTop="25dp"
                    android:textColorHighlight="@color/cardview_dark_background" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/edit_text"
                    android:id="@+id/phone"
                    android:drawableLeft="@drawable/ic_phone"
                    android:drawablePadding="20dp"
                    android:hint="Phone Number: 0000-0000000"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:inputType="phone"
                    android:textSize="16dp"
                    android:maxLength="12"
                    android:layout_marginTop="25dp"
                    android:textColorHighlight="@color/cardview_dark_background" />
                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/edit_text"
                    android:id="@+id/age"
                    android:drawableLeft="@drawable/ic_baseline_perm_contact_calendar_24"
                    android:drawablePadding="20dp"
                    android:hint="Age"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:inputType="number"
                    android:textSize="16dp"
                    android:layout_marginTop="25dp"
                    android:textColorHighlight="@color/cardview_dark_background" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginTop="17dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="1in"
                        android:layout_height="wrap_content"
                        android:fontFamily="times"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="CNIC Front Side"
                        android:textColor="@color/black"
                        android:textSize="16dp" />


                    <ImageView
                        android:id="@+id/frontside"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/form" />

                    <TextView
                        android:id="@+id/addf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="10dp"
                        android:text="Add +"
                        android:textColor="@color/end_red"
                        android:textSize="20dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="-30dp"

                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/submit_picf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/holo_green_dark" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:layout_marginTop="17dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="1in"
                        android:layout_height="wrap_content"
                        android:fontFamily="times"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="CNIC Back Side"
                        android:textColor="@color/black"
                        android:textSize="16dp" />


                    <ImageView
                        android:id="@+id/backside"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/form" />

                    <TextView
                        android:id="@+id/addb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:layout_marginTop="10dp"
                        android:text="Add +"
                        android:textColor="@color/end_red"
                        android:textSize="20dp"
                        android:textStyle="bold" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="-30dp"

                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/submit_picb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/holo_green_dark" />
                </LinearLayout>


                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/edit_text"
                    android:id="@+id/email"
                    android:drawableLeft="@drawable/ic_baseline_email_24"
                    android:drawablePadding="20dp"
                    android:hint="Email Address"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:inputType="textEmailAddress"
                    android:textSize="16dp"
                    android:layout_marginTop="25dp"
                    android:textColorHighlight="@color/cardview_dark_background"
                    />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <EditText
                        android:id="@+id/pass"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:drawablePadding="20dp"
                        android:padding="10dp"
                        android:hint="@string/password"
                        android:background="@drawable/edit_text"
                        android:inputType="textPassword"
                        android:textSize="16dp"
                        android:layout_marginTop="25dp"
                        android:drawableStart="@drawable/ic_password" />

                    <ImageView
                        android:id="@+id/show_hide_pass"
                        android:layout_width="49dp"
                        android:layout_height="34dp"
                        android:layout_marginLeft="280dp"
                        android:layout_marginTop="30dp"
                        android:src="@drawable/hide_pass" />

                </RelativeLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/mservices"
                    android:hint="@string/select_services_you_can_provide"
                    android:background="@drawable/edit_text"
                    android:padding="10dp"
                    android:layout_marginTop="25dp"
                    android:textColor="@color/black"
                    android:drawableEnd="@drawable/ic_arrow_drop_down"
                    android:textSize="16sp"
                    android:drawablePadding="20dp"
                    />
                <Button
                    android:id="@+id/mechregister"
                    android:layout_width="190dp"
                    android:layout_height="53dp"
                    android:layout_marginTop="25dp"
                    android:backgroundTint="@color/end_red"
                    android:text="Continue"
                    android:gravity="center"
                    android:textSize="18dp"
                    app:cornerRadius="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/already_a_member"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:layout_marginBottom="12dp"
                        android:layout_marginLeft="64dp"
                        />

                    <TextView
                        android:id="@+id/signin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Login"
                        android:textAlignment="center"
                        android:textColor="@color/link"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>