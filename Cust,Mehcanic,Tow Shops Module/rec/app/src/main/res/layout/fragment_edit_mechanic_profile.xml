<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mech_bgd"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".EditMechanicProfile">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

    <LinearLayout
        app:cardCornerRadius="10dp"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@color/white"
        android:gravity="center"
        android:layout_marginTop="25dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="EDIT PROFILE"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="22dp"
            android:textColor="@color/end_red"
            android:layout_marginBottom="23dp"
            android:layout_margin="20dp"
            android:textStyle="bold" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/editProfileImgofMech"
            android:layout_width="173dp"
            android:layout_height="99dp"
            android:layout_weight="1"
            app:civ_border_color="@color/end_red"
            app:civ_border_width="2dp"
            android:src="@drawable/ic_person" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/edit_text"
            android:id="@+id/editProfileNameofMech"
            android:drawableLeft="@drawable/ic_person"
            android:drawablePadding="20dp"
            android:hint="@string/full_name"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginTop="15dp"
            android:textColorHighlight="@color/cardview_dark_background" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:enabled="false"
            android:background="@drawable/edit_text"
            android:id="@+id/editProfileCnicofMech"
            android:drawableLeft="@drawable/cnic"
            android:drawablePadding="20dp"
            android:hint="Cnic: 00000-0000000-0"
            android:padding="10dp"
            android:textColor="@color/black"
            android:textSize="16dp"
            android:maxLength="15"
            android:inputType="text"
            android:layout_marginTop="25dp"
            android:textColorHighlight="@color/cardview_dark_background" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/edit_text"
            android:id="@+id/editProfilePhoneofMech"
            android:drawableLeft="@drawable/ic_phone"
            android:drawablePadding="20dp"
            android:hint="Phone Number: 0000-0000000"
            android:padding="10dp"
            android:textColor="@color/black"
            android:inputType="phone"
            android:textSize="16dp"
            android:maxLength="12"
            android:layout_marginTop="25dp"
            android:textColorHighlight="@color/cardview_dark_background" />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/edit_text"
            android:id="@+id/editProfileAgeofMech"
            android:drawableLeft="@drawable/ic_baseline_perm_contact_calendar_24"
            android:drawablePadding="20dp"
            android:hint="Age"
            android:maxLength="2"
            android:padding="10dp"
            android:textColor="@color/black"
            android:inputType="number"
            android:textSize="16dp"
            android:layout_marginTop="25dp"
            android:textColorHighlight="@color/cardview_dark_background" />


        <EditText
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/edit_text"
            android:id="@+id/editProfileEmailofMech"
            android:drawableLeft="@drawable/ic_baseline_email_24"
            android:drawablePadding="20dp"
            android:hint="Email Address"
            android:enabled="false"
            android:padding="10dp"
            android:textColor="@color/black"
            android:inputType="textEmailAddress"
            android:textSize="16dp"
            android:layout_marginTop="25dp"
            android:textColorHighlight="@color/cardview_dark_background"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/editPrfoileServicesofMech"
            android:hint="@string/select_services_you_can_provide"
            android:background="@drawable/edit_text"
            android:padding="10dp"
            android:layout_marginTop="25dp"
            android:textColor="@color/black"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:textSize="16sp"
            android:drawablePadding="20dp"
            />
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/resetpasswd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="Reset Password?"
                android:textAlignment="center"
                android:textColor="@color/link"
                android:textSize="16sp"
                android:textStyle="bold" />


        </RelativeLayout>
        <Button
            android:id="@+id/saveChangesofMech"
            android:layout_width="190dp"
            android:layout_height="53dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="@color/end_red"
            android:text="Save Changes"
            android:gravity="center"
            android:textSize="18dp"
            app:cornerRadius="20dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0.5in"></TextView>
    </LinearLayout>

    </ScrollView>
</LinearLayout>
