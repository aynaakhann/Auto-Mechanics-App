<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AfterConfirmTowingByCust">

    <fragment
        android:id="@+id/afterconfirmmapforcust"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".AfterConfirmTowingByCust" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/alertcallT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="330dp"
        android:layout_marginEnd="23dp"
        android:src="@drawable/ic_alert_call"
        app:backgroundTint="@color/white"
        app:fabCustomSize="40dp"
        app:tint="#FF0000" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/shareLocationT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/alertcallT"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="23dp"
        android:src="@drawable/ic_send_location"
        app:backgroundTint="@color/white"
        app:fabCustomSize="40dp"
        app:tint="@color/teal_700" />

    <Button
        android:id="@+id/service_donebyCust"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="90dp"
        android:layout_marginTop="620dp"
        android:layout_marginEnd="40dp"
        android:backgroundTint="@color/green"
        android:text="Service is done?"
        android:textColor="#FFFFFF"
        android:textSize="20dp" />

</RelativeLayout>