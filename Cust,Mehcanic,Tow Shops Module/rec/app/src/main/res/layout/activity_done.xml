<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".done"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Success!"
        android:layout_marginTop="1.3in"
        android:textSize="29dp"
        android:layout_gravity="center"
        android:textStyle="bold"
        ></TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:text="Your Request has been submitted."
        ></TextView>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="95dp"
        android:src="@drawable/done"></ImageView>
    <TextView
        android:layout_width="1.9in"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:layout_marginTop="14dp"
        android:text="We'll activate your account, once your request has been verified."
        ></TextView>
    <Button
        android:layout_width="2.1in"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:layout_marginTop="0.7in"
        android:text="Ok"
        android:id="@+id/okbtn"
        ></Button>
</LinearLayout>