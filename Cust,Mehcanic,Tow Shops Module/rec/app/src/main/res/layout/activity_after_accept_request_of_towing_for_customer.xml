<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent" android:layout_width="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".after_accept_request_polyline_for_customer">


        <fragment
            android:id="@+id/journeyStartedCust"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="570dp" />

        <Button
            android:id="@+id/confirmTow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/journeyStartedCust"
            android:layout_marginStart="60dp"
            android:layout_marginTop="37dp"
            android:layout_marginEnd="40dp"
            android:backgroundTint="@color/green"
            android:text="Confirm Towing Vehicle has reached?"
            android:textSize="20dp" />
    </RelativeLayout>
</ScrollView>
