<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".towingSideComplaints">

    <EditText
        android:id="@+id/complain_multiline"
        android:layout_width="280dp"
        android:layout_height="111dp"
        android:ems="10"
        android:gravity="start|top"
        android:hint="Type your complain here:"
        android:inputType="textMultiLine"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.462" />

    <EditText
        android:id="@+id/phoneForComplaints"
        android:layout_width="294dp"
        android:layout_height="38dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/edit_text"
        android:drawableLeft="@drawable/ic_phone"
        android:drawablePadding="20dp"
        android:hint="Phone Number: 0000-0000000"
        android:inputType="phone"
        android:maxLength="11"
        android:padding="10dp"
        android:textColor="@color/black"
        android:textColorHighlight="@color/cardview_dark_background"
        android:textSize="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.513"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.299" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="301dp"
        android:layout_height="85dp"
        android:text="Enter the Phone number of the person, you are complaining about:"
        android:textColor="@color/end_red"
        android:textSize="20dp"
        app:autoSizeMinTextSize="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.545"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.187"
        app:textAllCaps="false" />

    <Button
        android:id="@+id/submit_complain"
        android:layout_width="134dp"
        android:layout_height="51dp"
        android:text="submit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.704" />

</androidx.constraintlayout.widget.ConstraintLayout>