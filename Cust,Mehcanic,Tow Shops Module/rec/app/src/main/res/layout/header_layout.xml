<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="240dp"
    android:orientation="vertical"
    android:background="@color/end_red">

    <ImageView
        android:id="@+id/mech_profile_img"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/mech_profile_image"
        android:layout_gravity="center"
        android:layout_marginTop="65dp"
        android:contentDescription="Header Image"/>
    <TextView
        android:id="@+id/mech_profile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
         android:text="Mech Name"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="24sp"/>
    <TextView
        android:id="@+id/mech_profile_phone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mech Number"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="16sp"/>



</LinearLayout>